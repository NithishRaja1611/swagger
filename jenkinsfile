pipeline {
    agent any

    environment {
        SONAR_TOKEN = credentials('sonarqube-token')       // Secret Text
        SONAR_HOST_URL = 'http://localhost:9000'
        ACR_LOGIN_SERVER = 'nithish1611.azurecr.io'
        IMAGE_NAME = 'aspnet-app'
        REGISTRY = "${ACR_LOGIN_SERVER}"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git credentialsId: 'github-credentials', url: 'https://github.com/Vehonitor/sampleAsp.net.git', branch: 'start-branch'
            }
        }

        stage('Restore Dependencies') {
            steps {
                bat 'dotnet restore'
            }
        }

        stage('Run SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    bat """
                        dotnet tool install --global dotnet-sonarscanner
                        set PATH=%PATH%;%USERPROFILE%\\.dotnet\\tools
                        dotnet sonarscanner begin /k:"aspnet-app" /d:sonar.host.url=%SONAR_HOST_URL% /d:sonar.login=%SONAR_TOKEN%
                        dotnet build --configuration Release
                        dotnet sonarscanner end /d:sonar.login=%SONAR_TOKEN%
                    """
                }
            }
        }

        stage('Publish') {
            steps {
                bat 'dotnet publish -c Release -o out'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("${ACR_LOGIN_SERVER}/aspnet-app:${env.BUILD_NUMBER}", "CleanArchitectureDemo")
                }
            }
        }
        stage('Trivy Image Scan') {
            steps {
                script {
                    echo 'Running Trivy scan...'
                    bat """
                    trivy image --exit-code 0 --severity CRITICAL,HIGH ${ACR_LOGIN_SERVER}/aspnet-app:${env.BUILD_NUMBER} > trivy-report.txt
                    """
                }
            }
        }



        stage('Push Docker Image to ACR') {
            steps {
                script {
                    docker.withRegistry("https://${ACR_LOGIN_SERVER}", 'acr-admin-login') {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Deploy to AKS') {
            steps {
                withCredentials([file(credentialsId: 'aks-kubeconfig', variable: 'KUBECONFIG')]) {
                    script {
                        // Replace image dynamically in deployment YAML
                        bat """
                        powershell -Command "(Get-Content aspnet-deployment.yaml) -replace 'image: .*', 'image: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}' | Set-Content aspnet-deployment-temp.yaml"
                        """
                        bat "kubectl --kubeconfig=%KUBECONFIG% apply -f aspnet-deployment-temp.yaml"
                        bat "kubectl --kubeconfig=%KUBECONFIG% apply -f aspnet-service.yaml"
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Cleaning up...'
            deleteDir()
        }
        failure {
            echo 'Build failed.'
        }
        success {
            echo 'Build completed successfully!'
        }
    }
}
